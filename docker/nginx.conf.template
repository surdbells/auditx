server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Security headers (OWASP baseline; HSTS is terminated at the bank's reverse proxy in production).
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Proxy API calls to the backend service. ${API_UPSTREAM} is substituted at container start (nginx's
    # docker-entrypoint envsubst-on-templates step) so the same image works unchanged in Compose
    # (API_UPSTREAM=api:8080, the default below) and in Azure Container Apps, where the API's internal-DNS
    # name has no port (see docs/AZURE_DEPLOYMENT_RUNBOOK.md).
    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cookie_path / "/; HttpOnly";
    }

    location /admin/health {
        proxy_pass http://${API_UPSTREAM};
    }

    # SPA fallback: serve index.html for client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
