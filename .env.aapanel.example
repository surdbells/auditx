# AuditX — aaPanel / Linux VPS demo stack configuration.
#
# Copy this file to `.env` in the same directory as docker-compose.aapanel.yml, then fill in real values:
#     cp .env.aapanel.example .env
# NEVER commit the resulting `.env` — it holds secrets.

# SQL Server 'sa' password. SQL Server enforces complexity: 8+ characters with at least three of
# upper-case, lower-case, digits, symbols. Use 16+ characters. Generate one, e.g.:  openssl rand -base64 24
SA_PASSWORD=CHANGE_ME_Strong_Passw0rd_16chars

# JWT signing key — 32+ bytes of high entropy. Generate one with:  openssl rand -base64 48
JWT_SIGNING_KEY=CHANGE_ME_run_openssl_rand_base64_48

# The EXACT origin users type in the browser to reach the demo (must match what the aaPanel proxy serves).
# Examples:
#   https://203.0.113.10          (aaPanel reverse proxy with a self-signed cert on the server IP — recommended)
#   http://203.0.113.10:8090      (hitting the web container directly, no proxy/TLS — quick but ungated)
#   https://audit.example.com     (once you point a domain at the server and switch to Let's Encrypt)
PUBLIC_ORIGIN=https://YOUR_SERVER_IP

# Host loopback port the web container listens on; aaPanel's reverse proxy targets 127.0.0.1:<WEB_PORT>.
WEB_PORT=8090
