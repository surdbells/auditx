<Project>

  <!--
    Shared MSBuild properties for every project in the AuditX backend solution.
    Enforces the engineering standards: nullable reference types, latest C#,
    deterministic builds, and warnings-as-errors for production-ready code.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <!-- Must stay false: Microsoft.Data.SqlClient does not support globalization-invariant mode and
         throws on connection-open, which would break every SQL Server interaction (API and tests). -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Pin transitive dependencies centrally so we can override vulnerable transitive packages
         (e.g. the old Newtonsoft.Json pulled in by Hangfire). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>

  <!-- Test projects opt out of warnings-as-errors noise from test tooling. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
