    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AuditX.Infrastructure\AuditX.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\AuditX.Application\AuditX.Application.csproj" />
    <ProjectReference Include="..\..\src\AuditX.Domain\AuditX.Domain.csproj" />
  </ItemGroup>

</Project>
