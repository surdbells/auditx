{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Identity": {
    "Provider": "ActiveDirectory",
    "AdReverificationMinutes": 5
  },
  "Jwt": {
    "SigningKey": "",
    "Issuer": "auditx",
    "Audience": "auditx",
    "SlidingMinutes": 480,
    "AbsoluteMinutes": 1440
  },
  "Redis": {
    "ConnectionString": "",
    "InstanceName": "auditx:"
  },
  "DataProtection": {
    "KeyRingPath": ""
  },
  "ActiveDirectory": {
    "Host": "",
    "Port": 636,
    "UseLdaps": true,
    "BaseDn": "",
    "ServiceAccountDn": "",
    "ServiceAccountPassword": "",
    "UpnSuffix": ""
  },
  "ActiveDirectoryApi": {
    "BaseUrl": "",
    "AuthenticatePath": "/authenticate",
    "LookupPath": "/users/{account}",
    "StatusPath": "/users/by-sid/{sid}",
    "ApiKeyHeader": "X-Api-Key",
    "ApiKey": "",
    "TimeoutSeconds": 15
  },
  "Cors": {
    "Origins": []
  }
}
